# Server-side Google Maps API key. Used for Places (new), Routes,
# and optional Distance Matrix. Restrict by IP in production.
GOOGLE_MAPS_API_KEY=your_google_maps_server_key

# Optional Clerk secret key. Auth features (saved trips, favorites) are
# disabled locally when this is left blank.
CLERK_SECRET_KEY=sk_test_...

# Set to true to plan route-first with one cached Routes API call per request.
# Set to false to use the ellipse + haversine corridor instead.
USE_ROUTE_POLYLINE=true

# Fallback edge provider when the polyline is unavailable.
# true  = Haversine distance x 1.2 at 88 km/h (default; no API cost)
# false = Google Distance Matrix API
USE_HAVERSINE_EDGES=true

# Server port. The Vite dev proxy expects this to be 3001.
PORT=3001

# DynamoDB table names (only used in Lambda; leave blank for local dev).
# The server falls back to JSON files under server/src/data/ when unset.
EDGE_CACHE_TABLE=
PLACES_CACHE_TABLE=
POLYLINE_CACHE_TABLE=
USER_DATA_TABLE=
