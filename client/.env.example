# Google Maps API key for the browser-side Maps JS SDK.
# Restrict by HTTP referrer in production.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# Optional. Leave blank for local dev (Vite proxies /api/* to localhost:3001).
# In production, set this to the API Gateway URL from cdk deploy.
VITE_API_URL=

# Optional Clerk publishable key. Auth features (saved trips, favorites) are
# disabled locally when this is left blank.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
